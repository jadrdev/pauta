<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array><string>group.dev.jadrdev.pauta</string></array>
    <!-- El contenedor de iCloud propio (fase 0 del plan del contenedor). -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.dev.jadrdev.pauta</string></array>
    <!-- CloudKit, desde la fase 0 del plan de CloudKit (docs/plan-cloudkit.md). -->
    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudDocuments</string><string>CloudKit</string></array>
    <!-- Los avisos silenciosos con los que CloudKit dice «ha cambiado algo». En
         desarrollo aquí; al exportar para la tienda o con Developer ID, Xcode lo
         pasa a producción. -->
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array><string>iCloud.dev.jadrdev.pauta</string></array>
</dict>
</plist>
