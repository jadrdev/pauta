    "Pega el texto de un PDF o de un mensaje con fechas. Abajo sale lo que se ha entendido, antes de crear nada." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enganxa el text d'un PDF o d'un missatge amb dates. A sota surt el que s'ha entès, abans de crear res. De moment només entén dates escrites en castellà."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
