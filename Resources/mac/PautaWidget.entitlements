<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- El widget **sí** va en sandbox: en macOS una extensión de widget no se
         carga de otra manera. Por eso no puede leer los datos y lee la
         instantánea que le deja la app en la carpeta del grupo. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array><string>26W4G92PSS.dev.jadrdev.pauta</string></array>
</dict>
</plist>
